[node name="BerthBoard" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(212, 791)
prompt = "Read the berth board"
title = "BERTH V1"
entries = PackedStringArray("Vesper Rock, mining and survey outpost. Population 212. One berth, two pads, no gift shop.", "Jump arrivals come out 560 m west of the berth, heading east. Follow the lane lights in: green to starboard, red to port.", "The gangway is 52 m with the walkway running. Its doors only open while a frigate is clamped in and sealed.", "Small craft can't make the crossing alone. They ride over on a frigate's flight deck.")

[node name="ArrivalsNotice" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(188, 848)
prompt = "Read the arrivals notice"
title = "ARRIVALS"
entries = PackedStringArray("Welcome to Vesper Rock. Hab A is down the trunk: the cantina on your right, Ops on your left.", "The apron airlock is at the bottom of the adit, past Hab B and the core store. It is a walk. Everything here is.", "Declare all coffee. This is not a customs matter. We are simply asking.")

[node name="BerthLog" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(-20, 721)
prompt = "Read the berth log"
title = "BERTH MASTER"
entries = PackedStringArray("V1 capture box is a few metres long and less wide. Bring the ship's centre into it slow and parallel to the spar. The clamps do the rest.", "Reminder: the frigate lane is kept clear from one side of the sector to the other. That includes your rock, survey team.", "Walkway belts in the gangway and the trunk run both ways. Whichever way you are going, yours is the one on the left.", "Quiet shift. Counted the lane lights again. Still forty.")

[node name="HabBoard" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(0, 1842)
prompt = "Read the hab board"
title = "HAB A NOTICES"
entries = PackedStringArray("Vesper Rock. Population 212. Days since someone flew a rock into the spar: 4.", "Pads Vesper 1 and Vesper 2 are for small craft. The supply drop is the striped square east of the pads.", "Apron airlock: down the crew way, through Hab B, to the bottom of the adit. Helmet on before the outer hatch.", "Lost: one left boot, mag sole. Found: one right boot. These facts may be related.")

[node name="SlagBoard" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(-100, 1792)
prompt = "Read the board"
title = "THE SLAG HEAP"
entries = PackedStringArray("Today: stew. Yesterday: stew. The coffee is bad on purpose. It builds character.", "House rule: talking ore grades costs a round. Hull-damage stories cost two.", "The machine by the door holds five cans a restock and gives no refunds. Do not hoard the Comet Citrus.", "Open mic is cancelled until the day shift apologises to the night shift.")

[node name="OutpostLog" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(130, 1661)
prompt = "Read the outpost log"
title = "VESPER CONTROL"
entries = PackedStringArray("Belt survey: about forty rocks on station around us. One in four carries ore. Look for the teal-gold veins.", "An ore rock leaves one ORE canister when it is shot apart. The WREN's pulse cannons do it: Space, or the trigger. The pieces it breaks into are plain rock.", "Canisters go in a PETREL's hold: hook one with the mag-line and reel it in. Ten slots, one canister each.", "ORE RUN: canisters are wanted at Meridian's Yards intake, not here. Our supply drop turns ore away. We dig it, we don't want it back.", "VESPER RESUPPLY: any other container set down inside the stripes of the supply drop on the apron counts. We are out of filters. And coffee.")

[node name="AssayResults" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(112, 1780)
prompt = "Read assay results"
title = "ASSAY BENCH"
entries = PackedStringArray("Sample 212-A: teal-gold vein, high grade. Sample 212-B: grey. Sample 212-C: also grey. The belt is mostly grey.", "A big rock splits into two or three smaller ones before it gives up. Only an ore-bearing rock drops a canister, and only one.", "BELT CLEARANCE pays per rock broken, ore or not. Survey calls it science. Everyone else calls it target practice.")

[node name="BeltMapScreen" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(38, 1764)
prompt = "Read the belt map"
title = "BELT MAP"
entries = PackedStringArray("Nothing drifts within 100 m of the frigate lane, the rock or the pads. Everything else out there moves, slowly.", "Rocks come in three sizes: 4 m, 9 m and 18 m across. The 18 m ones weigh 500 tonnes. Do not argue with them in a WREN.")

[node name="ShiftRoster" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(-188, 2101)
prompt = "Read the shift roster"
title = "SHIFT ROSTER"
entries = PackedStringArray("Day shift: pit, crusher, screen house. Night shift: asleep next door. Leave their lights off.", "Whoever fixes the core store light gets my dessert for a week. Ticket #212. Yes, really.", "Apron duty: check the hoppers' chutes are clear before the PETREL comes in for cargo. It lands anywhere on the deck. It will pick your spot.")

[node name="ApronBoard" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(-140, 2738)
prompt = "Read the apron board"
title = "APRON LOCK"
entries = PackedStringArray("Outside, facing the deck: pads Vesper 1 and Vesper 2 are to the west, the supply drop and the ore hoppers to the east.", "A PETREL can set down anywhere on the deck. Hold hover over it until the skids take the weight, then step out.", "From outside this door is marked HAB A. It is the only door on the apron. If you find another one, tell Ops.")

