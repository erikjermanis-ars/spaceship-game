[node name="LineMap" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(125.0, 191.5)
prompt = "Read the line map"
title = "PIER LINE"
entries = PackedStringArray("MERIDIAN TRANSIT. Four stops in a row: Hangar 2, Pier 7 North, Pier 7 South, Cargo Yard C. You are at Pier 7 North.", "West pod: Hangar 2. East pod: Pier 7 South, for airlock 7B, Pad 2 and Berth E2. Change there for Cargo Yard C.", "Pods run on demand. Step up to the doors and ask; the pod does the rest.", "Notice: pods do not wait for coffee. Lids on, please.")

[node name="Directory" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(125.0, 127.0)
prompt = "Read the directory"
title = "PIER 7 NORTH"
entries = PackedStringArray("North concourse. Transit platform: through the doors behind this board. Berth E1 lounge and gangway: north-east. Quartermaster and customs: north-west.", "Berth E1 is the HALCYON's home, Berth E2 the KESTREL's. A frigate may put in at any free berth, either side to the pier.", "The landing pads are on the pier's west face. For Pad 2 ride the pod to Pier 7 South and cycle out through airlock 7B.", "A room gone dark? Your helmet lamp works indoors (F). The wall switch is always just inside the door.")

[node name="HoloTable" type="Node2D" parent="Interactive"]
script = ExtResource("11")
position = Vector2(125.0, 103.0)
radius_m = 1.2

[node name="CustomsDesk" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(50.0, 45.0)
prompt = "Read the manifest"
title = "QUARTERMASTER"
entries = PackedStringArray("Standing contracts are on every ship's board: YARDS SUPPLY, GUNNERY QUAL, VESPER RESUPPLY, BELT CLEARANCE, ORE RUN. Filling one raises the next target.", "ORE RUN: canisters mined at Vesper Rock, delivered to the Yards Supply Intake here at Meridian. Vesper's own supply drop turns ore away.", "Small ships can't jump. Park the WREN and the PETREL on a frigate's flight deck and the frigate carries them.", "Bonded store audit: 14 crates in, 14 crates out, one pallet jack unaccounted for. It is behind this counter.")

[node name="DeskLamp" type="Node2D" parent="Interactive"]
script = ExtResource("9")
