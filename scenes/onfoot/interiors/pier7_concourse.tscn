[node name="TrafficLog" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(177.5, 131.0)
prompt = "Read traffic log"
title = "PIER 7 TRAFFIC"
entries = PackedStringArray("11 craft in the local pattern. Lanes nominal. Crane C cycling every 24 s.", "Pad 2: courier WREN (MC-07) docked, clamped, crew on foot.", "Hangar Bay blast doors on auto-cycle. Do not loiter in the doorway.", "Meridian Circuit open for time trials. Current best lap posted on the pier board.", "Berth E2: frigate KESTREL (MFF-07) clamped, gangway sealed. Crew access through the south wing.")

[node name="Departures" type="Node2D" parent="Interactive"]
