rotation = -3.1416

[node name="Departures" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(120.0, 66.0)
prompt = "Read the departures board"
title = "BERTH E1"
entries = PackedStringArray("HALCYON (MFF-04), civil exploration frigate, Meridian Exploration Service. Refit signed off. Home berth: E1.", "Gangway: through the gate in the east wall. It opens only while a ship is clamped in and the gangway is sealed.", "Aboard: the bridge is forward, the flight deck aft. E at the captain's chair takes the helm. Holding any flight key undocks.", "Coming back: ship's centre in the capture box, within 4 degrees of the berth heading, under 1.2 m/s, and hold it for a second. The clamps do the rest.", "KESTREL (MFF-07) is in Berth E2. Take the pod to Pier 7 South.")

