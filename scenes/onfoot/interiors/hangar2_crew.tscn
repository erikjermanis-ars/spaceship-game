[node name="FlightOps" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(38, -175.5)
prompt = "Read the PETREL brief"
title = "FLIGHT OPS"
entries = PackedStringArray("MSV PETREL, Bay 2-S, north-west of airlock H2. Heavy hover shuttle: slow to turn, slower to stop.", "Hover: hold Space. She brakes to a stop and holds her heading. Keep holding over any deck and she lands.", "Mag-line: hold left mouse (or V) to hook the highlighted cargo. Let go and the load flies off the hook.", "Towing is not stowing. Hold right mouse (or B) to reel a container right in, and the hold swallows it.", "The hold has ten slots. Hold U in flight, with clear space astern, to push the last one back out.", "Freight goes to the Yards Supply Intake, the striped pad south of the drydock. Hover over it and hold U.")

[node name="PartsLog" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(78.5, -228)
prompt = "Read the parts log"
title = "PARTS STORE"
entries = PackedStringArray("PETREL mag-skids: lock lamps replaced. All four glow cyan when she is clamped to the deck.", "Each filled slot adds 160 kg. Ten of them and a 2.6 tonne shuttle flies like 4.2. Brake early.", "Winch serviced. It reels at 4 m/s and stalls under load. That is the winch working. Stop filing tickets.", "A twelve-metre container takes two slots, a six-metre one takes one. No, you cannot fold them.")

[node name="DutyBoard" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(71, -17)
prompt = "Read the duty board"
title = "DUTY BOARD"
entries = PackedStringArray("Airlock H2 opens on the bay floor. The PETREL is in Bay 2-S, north-west of the door. Her ramp is on the far side: press E there.", "Blast doors are on auto-cycle. The interlock holds them for a ship in the doorway. Not for you.", "Pier Line pods leave from the platform, south end. The parts store is past the ready room, north end.", "Whoever borrowed the PETREL's spare floodlight: it is not a reading lamp. Bring it back.")

[node name="LineMap" type="Node2D" parent="Interactive"]
script = ExtResource("12")
position = Vector2(22, 102.5)
prompt = "Read the line map"
title = "PIER LINE"
entries = PackedStringArray("HANGAR 2  >  Pier 7 North  >  Pier 7 South  >  Cargo Yard C. You are at the north end of the line.", "Pier 7 North: Berth E1, home berth of the frigate HALCYON.", "Pier 7 South: airlock 7B to Pad 2, and the Berth E2 gangway to the frigate KESTREL.", "Cargo Yard C: yard control, and more containers than the PETREL can carry in a week.")

