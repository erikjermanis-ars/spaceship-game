## Half beam (m) of the main body at x (m): piecewise linear through BODY.
static func half_beam(x_m: float) -> float:
	var best := 0.0
	var n := BODY.size()
	for i in n:
		var a: Vector2 = BODY[i]
		var b: Vector2 = BODY[(i + 1) % n]
		var x := x_m * 10.0
		if (a.x - x) * (b.x - x) > 0.0 or is_equal_approx(a.x, b.x):
			continue
		var y := lerpf(a.y, b.y, (x - a.x) / (b.x - a.x))
		best = maxf(best, absf(y))
	return best / 10.0


## Outlines for radar, guidance ghosts and diagrams (local px): the body, then
## both rings' outer and inner edges.
static func outlines() -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = [PackedVector2Array(BODY)]
	for s: float in [1.0, -1.0]:
		for src: Array in [RING_OUTER, RING_INNER]:
			var p := PackedVector2Array()
			for v: Vector2 in src:
				p.append(Vector2(v.x, v.y * s))
			out.append(p)
	return out
