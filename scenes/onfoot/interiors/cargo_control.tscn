[node name="YardNotices" type="Node2D" parent="Interactive"]
script = ExtResource("10")
position = Vector2(235.0, 68.0)
prompt = "Read the yard notices"
title = "YARD C NOTICES"
entries = PackedStringArray("Crane C is live. It slews 46 degrees either side of due west, one full swing every 24 seconds. The amber arc on the deck is its reach. Stay outside it.", "Airlock C4 opens south, onto the aisle between stacks C4 and C5. It is the one clear patch in this yard: set your shuttle down there.", "Loose boxes drift. If one is leaning on the airlock when you cycle out, that is what a mag-line is for.", "Transit: one pod, Pier Line, next stop Pier 7 South. End of the line, so you cannot board the wrong one.")

[node name="CraneDesk" type="Node2D" parent="Interactive"]
script = ExtResource("10")
position = Vector2(23.0, 140.0)
prompt = "Check the crane desk"
title = "CRANE C"
entries = PackedStringArray("Boom 100 m, on a pivot 80 m west and 50 m south of this desk. Sweep: 46 degrees either side of due west, 24 seconds a cycle.", "The spreader is carrying a TIDEWAY forty-footer. It has been carrying it all week. Do not ask.", "Pilots: the boom is solid and it does not stop for you. Time your run across the yard, or go round the north side.", "Anything loose inside the slew arc gets batted across the apron. That is the crane's problem first, then yours.")

[node name="YardLog" type="Node2D" parent="Interactive"]
script = ExtResource("10")
position = Vector2(80.0, 179.5)
prompt = "Read the yard log"
title = "YARD LOG"
entries = PackedStringArray("Forty-odd loose boxes on the apron and nobody has hauled a full hold out of here since Tuesday. The freight board is behind you. It is not flattering.", "A PETREL's hold is ten slots. A 6 m box takes one, a 12 m box takes two. Count before you reel.", "Hook a box with the mag-line, then reel it right alongside: the stern hatch only takes one that is close and slow. Towing is not stowing.", "Yards Supply Intake: north of the hub, the striped pad under the MERIDIAN YARDS sign. Set boxes down inside the stripes and it takes them one by one.", "Vesper Rock pays three times what the Yards do, and it is a quantum jump away. Land the loaded PETREL on a frigate's flight deck and ride along.")

[node name="ShiftBoard" type="Node2D" parent="Interactive"]
script = ExtResource("10")
position = Vector2(217.0, 163.0)
prompt = "Read the shift board"
title = "SHIFT BOARD"
entries = PackedStringArray("Whoever keeps leaving the pallet jack in the arrivals hall: it has a home. The arrivals hall is not it.", "Ore canisters go to the Yards intake, never to Vesper's supply drop. Vesper digs the stuff up. They will not take it back.", "A full hold makes a lazy ship. A loaded PETREL brakes late and turns wide: start slowing early.", "Comet Citrus is for closers.  - night shift")

[node name="LineMap" type="Node2D" parent="Interactive"]
script = ExtResource("10")
position = Vector2(272.0, 30.0)
prompt = "Read the line map"
title = "PIER LINE"
entries = PackedStringArray("MERIDIAN TRANSIT  ·  PIER LINE:  Hangar 2  -  Pier 7 North  -  Pier 7 South  -  Cargo Yard C. You are at the south end.", "One pod serves this stop. Step in and it leaves when the doors close. Next stop: Pier 7 South.", "Pier 7 South is the stop for Berth E2 and the KESTREL's gangway, when she is clamped in.", "Hangar 2 is the far end of the line: the hangar floor, and the PETREL's painted bay.")

