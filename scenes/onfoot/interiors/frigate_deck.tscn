[node name="CaptainsLog" type="Node2D" parent="Interactive"]
script = ExtResource("term")
position = Vector2(14.0, -722.0)
prompt = "Read the captain's log"
title = "CAPTAIN'S LOG"
entries = PackedStringArray("Shakedown, day 4. The new flight deck takes two small craft, nose in: the WREN on one pad, the PETREL on the other. Whatever sits on the pads rides with us through a jump.", "Quantum drive certified. Lay in a course at the nav table on the bridge, clear the station by a ship's length, then hold J at the helm. The rings do the rest.", "Vesper Rock asked for supplies again. Cargo Yard C has the containers, the PETREL has the hold: ten at a time.", "Note for the helm: the clamps take either side. Berth E1 wants us port side to, E2 starboard. Any free berth will have us.")

[node name="SickLog" type="Node2D" parent="Interactive"]
script = ExtResource("term")
position = Vector2(-100.0, -252.0)
prompt = "Read the medical log"
title = "SICKBAY"
entries = PackedStringArray("No crew in treatment. Biobeds calibrated.", "Two sprained ankles from the gangway travelator. Stand on it, then walk.", "Jump sickness is not real. The nausea is real. Sit down for the first five seconds.")

[node name="ScienceLog" type="Node2D" parent="Interactive"]
script = ExtResource("term")
position = Vector2(112.0, -470.0)
prompt = "Read the survey notes"
title = "SURVEY NOTES"
entries = PackedStringArray("Vesper is a ringed gas giant 6.7 light-years out. The outpost sits on a captured rock in its inner belt.", "One belt rock in four carries ore: look for the teal-gold veins. Crack one open and it leaves a canister behind.", "The drive rings do not push the ship. They fold the distance and the ship simply stops being here.")

[node name="DriveLog" type="Node2D" parent="Interactive"]
script = ExtResource("term")
position = Vector2(108.0, 236.0)
prompt = "Read the drive log"
title = "QUANTUM DRIVE"
entries = PackedStringArray("Ring spool: 3.2 s from idle to fold. Do not stand in the ring plane. Small craft may pass through a ring at rest.", "A jump needs a beacon at the far end. Meridian and Vesper Rock have one. Tideway Relay's is still dark.", "Minimum clearance to spool: one ship's length from any structure. The interlock will tell you.")

[node name="FlightOps" type="Node2D" parent="Interactive"]
script = ExtResource("term")
position = Vector2(-45.0, 346.0)
prompt = "Read the deck rules"
title = "FLIGHT OPS"
entries = PackedStringArray("Approach from dead astern, under 6 m/s. Pad A is to port, pad B to starboard. Settle and the clamps take you.", "The PETREL lands on its own skids anywhere on the deck: hold Space over it.", "The field at the mouth holds the air in. It does not hold ships out, or in. Mind your throttle.", "Whatever is parked here when the helm is taken rides with the ship, jump included.")

